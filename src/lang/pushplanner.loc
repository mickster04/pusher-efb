      "PUSHPLANNER.NEAR_A_TAXIWAY_A_PIN_IS_PULLED_ONTO_ITS_a33c": {
        "UUID": "cdf802f2-83c1-41af-841b-a24f45d93e3e",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:08:03.693Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Near a taxiway a pin is pulled onto its centreline and takes its heading (Settings: snap). Drag it further than 1.5 times the snap reach to pull it free.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Près d'une voie de circulation, un repère est attiré sur son axe et prend son cap (Réglages : aimantation). Faites-le glisser à plus de 1,5 fois la portée d'aimantation pour le libérer.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "In der Nähe eines Rollwegs wird ein Pin auf dessen Mittellinie gezogen und übernimmt dessen Richtung (Einstellungen: Einrasten). Ziehe ihn weiter als das 1,5-Fache des Einrastbereichs, um ihn zu lösen.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Cerca de una calle de rodaje, un marcador es atraído a su eje y toma su rumbo (Ajustes: imán). Arrástralo a más de 1,5 veces el alcance del imán para soltarlo.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Cerca de una calle de rodaje, un marcador es atraído a su eje y toma su rumbo (Configuración: imán). Arrástralo a más de 1.5 veces el alcance del imán para soltarlo.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
