      "PUSHPLANNER.DOES_THE_SIM_LIST_OTHER_AIRCRAFT_AND_IS_4d1c": {
        "UUID": "ed4133b2-7c0e-446d-a42a-5faebfd94b39",
        "LastModifiedBy": "tools/lang.mjs",
        "LastModifiedDate": "2026-11-09T20:56:01.063Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Does the sim list other aircraft, and is our own filtered out?",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Le simulateur liste-t-il les autres aéronefs, et le nôtre est-il exclu ?",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Listet der Simulator andere Flugzeuge auf, und wird das eigene herausgefiltert?",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
