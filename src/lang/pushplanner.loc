        "LastModifiedDate": "2026-11-09T04:33:40.004Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "{m} m of push to where the stand's lead-in meets the taxiway (no named taxiway here, so this is a guess); {tail}",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "{m} m de repoussage jusqu'à la jonction de l'entrée du poste avec la voie (pas de voie nommée ici, c'est donc une estimation) ; {tail}",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "{m} m Push bis zur Einmündung der Standzufahrt in den Rollweg (hier gibt es keinen benannten Rollweg, daher eine Schätzung); {tail}",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "{m} m de push hasta donde el acceso de la posición se une a la calle de rodaje (aquí no hay calle de rodaje con nombre, así que es una estimación); {tail}",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "{m} m de push hasta donde el acceso de la posición se une a la calle de rodaje (aquí no hay calle de rodaje con nombre, así que es una estimación); {tail}",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "PUSHPLANNER.PATTERN.M_M_OF_PUSH_ENDS_ON_THE_CENTRELINE_HEADI_dc24": {
        "UUID": "47204d3c-85e8-4880-a236-43db91fccc9a",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:33:40.004Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "{m} m of push; ends on the centreline heading {h} deg along it[{lineup}][. The tug may not manage this one: no cleaner end point found]",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "{m} m de repoussage ; se termine sur l'axe, cap {h} deg[{lineup}][. Le tracteur risque de ne pas y arriver : aucun point d'arrivée plus propre trouvé]",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "{m} m Push; endet auf der Mittellinie mit Kurs {h} Grad[{lineup}][. Der Schlepper schafft diese womöglich nicht: kein sauberer Endpunkt gefunden]",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "{m} m de push; termina en el eje con rumbo {h}° a lo largo de él[{lineup}][. Puede que el tractor no lo consiga: no se encontró un punto final más limpio]",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "{m} m de push; termina en el eje con rumbo {h}° a lo largo de él[{lineup}][. Puede que el tractor no lo consiga: no se encontró un punto final más limpio]",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
