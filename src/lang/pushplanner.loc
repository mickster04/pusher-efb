        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "The tug may not be able to make this {kind} manoeuvre: {why}. Move a pin further away, or shorten the final straight with the heading handle.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Le tracteur risque de ne pas réussir cette manœuvre ({kind}) : {why}. Éloignez un repère, ou raccourcissez la dernière ligne droite avec la poignée de cap.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Der Schlepper schafft dieses Manöver ({kind}) womöglich nicht: {why}. Setze einen Pin weiter weg oder verkürze die letzte Gerade mit dem Kursgriff.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Puede que el tractor no pueda hacer esta maniobra ({kind}): {why}. Aleja un marcador o acorta la recta final con el asa de rumbo.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Puede que el tractor no pueda hacer esta maniobra ({kind}): {why}. Aleja un marcador o acorta la recta final con el asa de rumbo.",
            "LocalizationStatus": "TranslationOk"
          }
