        "LastModifiedDate": "2026-11-09T20:56:01.063Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Normal logging",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Journalisation normale",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Normale Protokollierung",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Registro normal",
