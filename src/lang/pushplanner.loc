      "PUSHPLANNER.SUGGESTED_PUSHES_COME_FROM_THE_ORIGINAL_9d94": {
        "UUID": "3c8b2eb7-509c-44b4-abe7-39a5452997dd",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:08:03.693Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Suggested pushes come from the original app's suggester. Pick one and it becomes your plan; adding a pin of your own takes over from it.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Les repoussages suggérés viennent du module de suggestion de l'application d'origine. Choisissez-en un et il devient votre plan ; ajouter un repère de votre cru prend alors le relais.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Die vorgeschlagenen Pushes stammen vom Vorschlagsmodul der ursprünglichen App. Wähle einen, und er wird dein Plan; ein eigener Pin übernimmt danach.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Los pushes sugeridos provienen del sugeridor de la app original. Elige uno y pasa a ser tu plan; si añades un marcador propio, este toma el relevo.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Los pushes sugeridos provienen del sugeridor de la app original. Elige uno y pasa a ser tu plan; si añades un marcador propio, este toma el relevo.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
