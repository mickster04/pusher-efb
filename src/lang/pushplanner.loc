      "PUSHPLANNER.COMPACT_MAKES_THE_TEXT_AND_BUTTONS_SMALL_7210": {
        "UUID": "3bd974f4-b151-4e55-a991-85628393c8a4",
        "LastModifiedBy": "tools/lang.mjs",
        "LastModifiedDate": "2026-11-10T01:14:17.517Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Compact makes the text and buttons smaller, for a small tablet such as the one on the flight deck. Automatic chooses it when the screen is small.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Compact réduit le texte et les boutons, pour une petite tablette comme celle du poste de pilotage. Automatique le choisit quand l'écran est petit.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Kompakt macht Text und Tasten kleiner, für ein kleines Tablet wie das im Cockpit. Automatisch wählt es, wenn der Bildschirm klein ist.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Compacto reduce el texto y los botones, para una tableta pequeña como la de la cabina. Automático lo elige cuando la pantalla es pequeña.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Compacto reduce el texto y los botones, para una tableta pequeña como la de la cabina. Automático lo elige cuando la pantalla es pequeña.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
