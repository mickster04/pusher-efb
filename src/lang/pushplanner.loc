        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Checks the key events could be sent. Nothing is sent: the sim does not say whether they work.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Vérifie que les événements clavier pourraient être envoyés. Rien n'est envoyé : le simulateur n'indique pas s'ils fonctionnent.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Prüft, ob die Tastenereignisse gesendet werden könnten. Es wird nichts gesendet: Der Simulator sagt nicht, ob sie funktionieren.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Comprueba si se podrían enviar los eventos de tecla. No se envía nada: el simulador no indica si funcionan.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Comprueba si se podrían enviar los eventos de tecla. No se envía nada: el simulador no indica si funcionan.",
