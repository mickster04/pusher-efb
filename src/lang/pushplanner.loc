            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "{m} m : tout droit en arrière jusqu'à {w}, puis {d} m le long de celle-ci[ (en suivant son virage)][ (en suivant ses virages)][, finissant au-delà de {x} pour ne pas bloquer la liaison] ; se termine cap {h} deg",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "{m} m: gerade zurück zu {w}, dann {d} m darauf entlang[ (um seine Kurve)][ (um seine Kurven)][, endet hinter {x}, damit die Verbindung nicht blockiert wird]; endet mit Kurs {h} Grad",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "{m} m: recto hacia atrás hasta {w}, luego {d} m por ella[ (rodeando su curva)][ (rodeando sus curvas)][, terminando más allá de {x} para no bloquear el enlace]; termina con rumbo {h}°",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
