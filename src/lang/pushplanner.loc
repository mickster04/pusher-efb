      "PUSHPLANNER.WHICH_AIRCRAFT_THE_SIM_SAYS_THIS_IS_IT_G_6751": {
        "UUID": "5f67cf29-bfaa-46c1-bda4-9408ddfb07c2",
        "LastModifiedBy": "tools/lang.mjs",
        "LastModifiedDate": "2026-11-09T20:56:01.063Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Which aircraft the sim says this is. It goes at the top of the copied logs, so a problem can be traced to it.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Quel aéronef le simulateur indique. Il figure en tête des journaux copiés, afin de pouvoir y rattacher un problème.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Welches Flugzeug der Simulator meldet. Es steht am Anfang der kopierten Protokolle, damit sich ein Problem darauf zurückführen lässt.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Qué aeronave indica el simulador que es. Va al principio de los registros copiados, para poder rastrear un problema hasta ella.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Qué aeronave indica el simulador que es. Va al principio de los registros copiados, para poder rastrear un problema hasta ella.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
