      "PUSHPLANNER.NO_ROUTE_YET_TAP_THE_MAP_TO_DROP_PINS_OR_1155": {
        "UUID": "2aa90c34-a473-4200-aa46-4f2e30313edc",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:08:03.693Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "No route yet. Tap the map to drop pins, or pick a suggested push.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Pas encore de route. Touchez la carte pour poser des repères, ou choisissez un repoussage suggéré.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Noch keine Route. Tippe auf die Karte, um Pins zu setzen, oder wähle einen vorgeschlagenen Push.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Aún no hay ruta. Toca el mapa para colocar marcadores o elige un push sugerido.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Aún no hay ruta. Toca el mapa para colocar marcadores o elige un push sugerido.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "PUSHPLANNER.NO_SUGGESTIONS_NO_NAMED_TAXIWAY_LINK_OR_7ae9": {
        "UUID": "795556d0-6dc9-4b37-84f5-3fa903906927",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:08:03.693Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "No suggestions: no named taxiway, link or lane is within reach where the tail points, or the taxi module supplied no paths ({n} items loaded). You can still drop pins by hand.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Aucune suggestion : aucune voie nommée, liaison ou allée n'est à portée là où pointe la queue, ou le module de circulation n'a fourni aucun chemin ({n} éléments chargés). Vous pouvez toujours poser des repères à la main.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Keine Vorschläge: In Reichweite der Heckrichtung liegt kein benannter Rollweg, keine Verbindung und keine Spur, oder das Taxi-Modul hat keine Wege geliefert ({n} Elemente geladen). Pins lassen sich weiterhin von Hand setzen.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Sin sugerencias: no hay ninguna calle de rodaje con nombre, enlace o carril al alcance hacia donde apunta la cola, o el módulo de rodaje no suministró caminos ({n} elementos cargados). Aun así puedes colocar marcadores a mano.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Sin sugerencias: no hay ninguna calle de rodaje con nombre, enlace o carril al alcance hacia donde apunta la cola, o el módulo de rodaje no suministró caminos ({n} elementos cargados). Aun así puedes colocar marcadores a mano.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "PUSHPLANNER.NORTH_IS_UP_CENTRED_ON_THE_AIRCRAFT_TAP_bd3d": {
        "UUID": "64b26c75-8cfc-42d5-9bf5-16e4e1c96af8",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:08:03.693Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "North is up, centred on the aircraft. Tap the map to drop a pin; the last pin is where the aircraft ends up. Drag empty map to move it.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Le nord est en haut, centré sur l'avion. Touchez la carte pour poser un repère ; le dernier repère est la position finale de l'avion. Faites glisser la carte vide pour la déplacer.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Norden ist oben, zentriert auf das Flugzeug. Tippe auf die Karte, um einen Pin zu setzen; der letzte Pin ist die Endposition des Flugzeugs. Ziehe die leere Karte, um sie zu verschieben.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "El norte está arriba, centrado en la aeronave. Toca el mapa para colocar un marcador; el último marcador es donde acaba la aeronave. Arrastra el mapa vacío para moverlo.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "El norte está arriba, centrado en la aeronave. Toca el mapa para colocar un marcador; el último marcador es donde acaba la aeronave. Arrastra el mapa vacío para moverlo.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
