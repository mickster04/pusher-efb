      "PUSHPLANNER.CIRCLES_AT_A_QUARTER_HALF_THREE_QUARTERS_919a": {
        "UUID": "7464b482-b4b3-49c1-98a9-50d8c9e34d42",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T03:48:17.565Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Circles at a quarter, half, three quarters and the full range of the map. Off by default: a scale bar in the bottom left always shows the distance.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Cercles à un quart, à la moitié, aux trois quarts et à la portée complète de la carte. Désactivé par défaut : une échelle en bas à gauche indique toujours la distance.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Kreise bei einem Viertel, der Hälfte, drei Vierteln und der vollen Reichweite der Karte. Standardmäßig aus: Ein Maßstabsbalken unten links zeigt die Entfernung immer an.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Círculos a un cuarto, la mitad, tres cuartos y el alcance total del mapa. Desactivado por defecto: una barra de escala abajo a la izquierda muestra siempre la distancia.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Círculos a un cuarto, la mitad, tres cuartos y el alcance total del mapa. Desactivado por defecto: una barra de escala abajo a la izquierda muestra siempre la distancia.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
