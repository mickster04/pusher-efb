            "Text": "The beacon is being turned on: wait for it.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Le feu anticollision est en cours d'allumage : patientez.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Das Beacon wird eingeschaltet: bitte warten.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Se está encendiendo la baliza: espera.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Se está encendiendo la baliza: espera.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
      "PUSHPLANNER.THE_ROUTE_IS_A_LOOP_OR_STARTS_FAR_OFF_TH_cb4e": {
        "UUID": "7ef5a26d-bb3c-4119-9614-9bc9df564d6d",
        "LastModifiedBy": "tools/lang.mjs",
        "LastModifiedDate": "2026-11-10T02:52:32.432Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "The route is a loop or starts far off the way the aircraft points: change the pins.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "L'itinéraire est une boucle ou part très loin de la direction de l'aéronef : modifiez les repères.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Die Route ist eine Schleife oder beginnt weit abseits der Flugzeugrichtung: bitte die Pins ändern.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "La ruta es un bucle o empieza muy desviada de la dirección de la aeronave: cambia los marcadores.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "La ruta es un bucle o empieza muy desviada de la dirección de la aeronave: cambia los marcadores.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
