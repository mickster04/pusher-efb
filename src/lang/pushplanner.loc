      "PUSHPLANNER.EACH_PIN_IS_DRAWN_AS_AN_AIRCRAFT_POINTIN_c844": {
        "UUID": "1d770066-5abd-4d9a-89b3-40d407cebf4d",
        "LastModifiedBy": "draft translation, unreviewed",
        "LastModifiedDate": "2026-11-09T04:08:03.693Z",
        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Each pin is drawn as an aircraft pointing the way the nose will be there. Tap a pin to select it: drag it to move it, drag the yellow handle behind it to rotate it.",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "Chaque repère est dessiné comme un avion dont le nez pointe dans la direction prévue à cet endroit. Touchez un repère pour le sélectionner : faites-le glisser pour le déplacer, ou faites glisser la poignée jaune derrière lui pour le faire pivoter.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Jeder Pin wird als Flugzeug gezeichnet, dessen Nase dort in die vorgesehene Richtung zeigt. Tippe einen Pin an, um ihn auszuwählen: Ziehe ihn, um ihn zu verschieben, oder ziehe den gelben Griff dahinter, um ihn zu drehen.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Cada marcador se dibuja como una aeronave que apunta hacia donde estará el morro en ese punto. Toca un marcador para seleccionarlo: arrástralo para moverlo, arrastra el asa amarilla de detrás para girarlo.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
            "Text": "Cada marcador se dibuja como una aeronave que apunta hacia donde estará el morro en ese punto. Toca un marcador para seleccionarlo: arrástralo para moverlo, arrastra el asa amarilla de detrás para girarlo.",
            "LocalizationStatus": "TranslationOk"
          }
        }
      },
