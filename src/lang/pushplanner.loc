        "LocalizationStatus": "TranslationNeeded",
        "Languages": {
          "en-US": {
            "Text": "Waiting for the beacon: turn it on",
            "LocalizationStatus": "TranslationOk"
          },
          "fr-FR": {
            "Text": "En attente du feu anticollision : allumez-le",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Warte auf das Beacon: bitte einschalten",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Esperando la baliza: enciéndela",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
