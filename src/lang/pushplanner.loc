          },
          "fr-FR": {
            "Text": "Le frein est en cours de desserrage : patientez.",
            "LocalizationStatus": "TranslationOk"
          },
          "de-DE": {
            "Text": "Die Bremse wird gelöst: bitte warten.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-ES": {
            "Text": "Se está soltando el freno: espera.",
            "LocalizationStatus": "TranslationOk"
          },
          "es-MX": {
