{
  "name": "push-planner",
  "version": "0.1.0",
  "private": true,
  "description": "Push Planner: plans and drives a pushback from the MSFS 2024 EFB. Plain JS, no dependencies.",
  "scripts": {
    "build": "npm run build:all",
    "build:app": "node build.mjs",
    "clean": "node tools/clean.mjs",
    "clean:full": "node tools/clean.mjs --full",
    "setup": "node tools/setup.mjs",
    "lint": "node tools/lint.mjs",
    "format": "npx --yes prettier@3.3.3 --write \"src/**/*.js\" build.mjs tools/*.mjs",
    "test": "node build.mjs && node tools/lint.mjs && node --test \"test/*.test.mjs\"",
    "build:wasm": "bash wasm/build.sh",
    "build:all": "npm test && npm run build:wasm",
    "harness": "node build.mjs && node harness/serve.mjs"
  },
  "license": "MIT",
  "author": "Mike Cleaver"
}
