{
  "name": "push-planner",
  "version": "0.2.32",
  "private": true,
  "description": "Push Planner: plans and drives a pushback from the MSFS 2024 EFB. Plain JS, no dependencies.",
  "scripts": {
    "build": "node tools/build.mjs",
    "build:app": "node tools/build-app.mjs",
    "build:wasm": "bash wasm/build.sh",
    "test": "node tools/build-app.mjs && node tools/lint.mjs && node --test \"test/*.test.mjs\"",
    "lint": "node tools/lint.mjs",
    "format": "npx --yes prettier@3.3.3 --write \"src/**/*.js\" tools/build-app.mjs",
    "lang": "node tools/lang.mjs",
    "lang:check": "node tools/lang.mjs --check --strict",
    "bump": "npm version patch --no-git-tag-version",
    "setup": "node tools/setup.mjs",
    "clean": "node tools/clean.mjs",
    "clean:full": "node tools/clean.mjs --full",
    "harness": "node tools/build-app.mjs && node harness/serve.mjs"
  },
  "license": "MIT",
  "author": "Mike Cleaver"
}
